{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "os:default",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "bgutil-pot",
          "cmd": "bgutil-pot",
          "sidecar": true,
          "args": [
            "server",
            "--host",
            "127.0.0.1",
            "--port",
            "4416"
          ]
        },
        {
          "name": "yt-dlp",
          "cmd": "yt-dlp",
          "sidecar": true
        },
        {
          "name": "ytsubconverter",
          "cmd": "ytsubconverter",
          "sidecar": true,
          "args": [
            "--visual",
            {
              "validator": "[^-].*\\.[sS][rR][vV]3"
            },
            {
              "validator": "[^-].*\\.[aA][sS][sS]"
            }
          ]
        }
      ]
    },
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "bgutil-pot",
          "cmd": "bgutil-pot",
          "sidecar": true,
          "args": [
            "server",
            "--host",
            "127.0.0.1",
            "--port",
            "4416"
          ]
        },
        {
          "name": "yt-dlp",
          "cmd": "yt-dlp",
          "sidecar": true
        },
        {
          "name": "ytsubconverter",
          "cmd": "ytsubconverter",
          "sidecar": true,
          "args": [
            "--visual",
            {
              "validator": "[^-].*\\.[sS][rR][vV]3"
            },
            {
              "validator": "[^-].*\\.[aA][sS][sS]"
            }
          ]
        }
      ]
    },
    "shell:allow-kill",
    "opener:default"
  ]
}