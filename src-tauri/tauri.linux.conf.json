{
  "bundle": {
    "createUpdaterArtifacts": false,
    "externalBin": [
      "binaries/deno",
      "binaries/bgutil-pot",
      "binaries/quiver_yt-dlp",
      "binaries/ytsubconverter"
    ],
    "linux": {
      "appimage": {
        "files": {
          "/usr/bin/ffmpeg": "binaries/appimage/ffmpeg",
          "/usr/bin/ffprobe": "binaries/appimage/ffprobe"
        }
      },
      "deb": {
        "depends": ["ffmpeg"],
        "files": {
          "/etc/apt/sources.list.d/quiver.source": "linux/repository/quiver.sources",
          "/usr/share/keyrings/quiver-archive-keyring.gpg": "linux/keys/public_06_06_28.gpg"
        }
      },
      "rpm": {
        "depends": ["ffmpeg"],
        "files": {
          "/etc/yum.repos.d/quiver.repo": "linux/repository/quiver.repo"
        }
      }
    }
  }
}
